# 依赖
node_modules/

# ⚠️ 注意：DSH 插件的源码就在 lib/ 目录（lib/index.js 是插件入口），
#    因此 lib/ 绝不能加入忽略列表——否则仓库里没有插件代码。

# 构建产物（如果有独立的打包输出目录）
dist/
*.tsbuildinfo

# 环境变量与密钥 —— 绝不提交
.env
.env.local
.env.*.local
*.key
*.pem
credentials.json

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/

# 临时文件
*.tmp
.cache/
